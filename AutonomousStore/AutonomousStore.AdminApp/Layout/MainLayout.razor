@inherits LayoutComponentBase
@inject AppState AppState
@inject NavigationManager Nav

<div class="page">
    <main>
        <div class="top-row px-4">
            <a class="marca" href="/">
                <img src="img/logo-mark-alpha.png" alt="AutonomousStore" />
                <span class="marca-texto">
                    <span class="marca-nome"><b>Autonomous</b><i>Store</i></span>
                </span>
            </a>

            @* O painel e a loja abrem no mesmo navegador e ficavam identicos no
               topo. Este selo e o que evita repor estoque na aba errada. *@
            <span class="selo-admin">Painel</span>

            @if (AppState.IsAuthenticated)
            {
                @* NavLink marca `active` sozinho pela rota — nenhum estado novo
                   aqui dentro: quem sabe a pagina aberta e o roteador. *@
                <nav class="admin-nav">
                    <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
                    <NavLink href="/produtos">Produtos</NavLink>
                    <NavLink href="/monitor-prateleira">Prateleira</NavLink>
                    <NavLink href="/vendas">Vendas</NavLink>
                    <NavLink href="/gemeo-digital">Gêmeo Digital</NavLink>
                    <NavLink href="/ocorrencias">Ocorrências</NavLink>
                    <NavLink href="/suporte">Suporte</NavLink>
                </nav>

            }


            @* SEMPRE VISIVEL, inclusive antes de entrar.
               O tema era escolhido so DEPOIS do login — e a tela de login e
               justamente a primeira que a pessoa encara. Quem abre isto de
               madrugada levava um branco na cara e so podia arrumar depois
               de digitar a senha. Preferencia de leitura nao depende de
               credencial. *@
            <SeletorDeTema />

            @if (AppState.IsAuthenticated)
            {
                @* Antes do nome, e nao depois: o chip do operador e o fim
                   natural da barra, e por um controle depois dele o olho
                   passa a procurar o nome no meio. *@
                <span class="chip-operador">
                    <span class="chip-operador-avatar">@Inicial()</span>
                    <span class="chip-operador-nome">@AppState.AdminName</span>
                </span>
            }
        </div>

        <article class="content px-4">
            @if (AppState.IsAuthenticated)
            {
                <NotificationBar />
            }
            @Body
        </article>

        @* O gerente fica ao alcance em TODA pagina do painel, e nao numa rota
           propria: pergunta sobre estoque costuma nascer enquanto se olha
           outra coisa, e ter que sair da tela faz a pergunta nao ser feita. *@
        @if (AppState.IsAuthenticated)
        {
            <GerenteChat Perfil="PerfilDeQuemFala.Chefe" />
        }
    </main>

    <footer class="rodape">
        <div class="rodape-marca">
            <img src="img/logo-mark-alpha.png" alt="" />
            <span class="rodape-linha">AutonomousStore · Painel administrativo</span>
        </div>
        @if (AppState.IsAuthenticated)
        {
            <a class="rodape-sair" @onclick="Sair">Sair</a>
        }
    </footer>
</div>

@code {
    // So apresentacao: a inicial que aparece dentro do avatar. Nao ha estado
    // novo, nao ha chamada de API, e o nome ja vinha do AppState.
    private string Inicial()
    {
        var nome = AppState.AdminName;
        return string.IsNullOrWhiteSpace(nome) ? "?" : nome.Trim()[0].ToString().ToUpperInvariant();
    }

    private void Sair()
    {
        AppState.Logout();
        Nav.NavigateTo("/login");
    }
}
