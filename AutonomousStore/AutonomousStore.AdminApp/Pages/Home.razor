@page "/"
@inject AppState AppState
@inject NavigationManager Nav

<h1>Ferramentas administrativas</h1>
<p class="hint">Olá, @AppState.AdminName — painel interno da AutonomousStore.</p>

<div class="grade-acoes">
    <button type="button" class="card-acao" @onclick='() => Nav.NavigateTo("/produtos")'>
        <span class="card-acao-etiqueta">Catálogo</span>
        <span class="card-acao-titulo">Produtos e estoque</span>
        <span class="card-acao-apoio">Cadastrar, ajustar preço e repor</span>
    </button>

    <button type="button" class="card-acao" @onclick='() => Nav.NavigateTo("/monitor-prateleira")'>
        <span class="card-acao-etiqueta">Visão</span>
        <span class="card-acao-titulo">Monitor da prateleira</span>
        <span class="card-acao-apoio">Câmera, produtos vigiados e sessão aberta</span>
    </button>

    <button type="button" class="card-acao" @onclick='() => Nav.NavigateTo("/vendas")'>
        <span class="card-acao-etiqueta">Financeiro</span>
        <span class="card-acao-titulo">Histórico de vendas</span>
        <span class="card-acao-apoio">Compras concluídas e totais</span>
    </button>
</div>

<button class="btn-primary btn-suave btn-auto" @onclick="Logout">Sair do painel</button>

@code {
    protected override void OnInitialized()
    {
        if (!AppState.IsAuthenticated)
            Nav.NavigateTo("/login");
    }

    private void Logout()
    {
        AppState.Logout();
        Nav.NavigateTo("/login");
    }
}
