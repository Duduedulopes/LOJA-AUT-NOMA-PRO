@page "/monitor-prateleira"
@implements IAsyncDisposable
@inject ISessionApiService SessionApi
@inject IVisionApiService VisionApi
@inject IProductApiService ProductApi
@inject IJSRuntime JS
@inject AppState AppState
@inject NavigationManager Nav

<h1>Monitor da prateleira</h1>
<p class="hint">Configure quais produtos essa câmera vigia, e aponte a webcam pra simular retirar/devolver.</p>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="error-message">@_errorMessage</div>
}

@if (_pendingEntrySessions.Count > 0)
{
    <div class="card">
        <h3 class="category-heading">Clientes aguardando entrada</h3>
        @foreach (var session in _pendingEntrySessions)
        {
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                <span class="hint">Sessão @session.Id.ToString()[..8]... — QR expira às @session.QrCodeExpiresAt.ToLocalTime().ToString("HH:mm:ss")</span>
                <button class="btn-primary btn-small" @onclick="() => ConfirmEntry(session.QrCodeToken)">
                    Confirmar entrada
                </button>
            </div>
        }
    </div>
}

<div class="card">
    <h3 class="category-heading">Produtos monitorados nesta prateleira</h3>

    @if (_products.Count == 0)
    {
        <p class="hint">Nenhum produto cadastrado no catálogo ainda.</p>
    }
    else
    {
        <div class="lista-monitorada">
        @foreach (var product in _products)
        {
            <label>
                <input type="checkbox"
                       checked="@_selectedProductIds.Contains(product.Id)"
                       @onchange="e => ToggleProduct(product.Id, (bool)e.Value!)" />
                @product.Name — R$ @product.Price.ToString("0.00")
            </label>
        }
        </div>
    }
</div>

<div class="card">
    @* Escolher a camera nao e luxo: a padrao do Windows costuma ser a
       integrada, e neste PC ela e justamente a unica que nao abre. *@
    <label class="linha-camera">
        <span class="hint">Câmera</span>
        <select @bind="_cameraId" disabled="@_isMonitoring">
            @if (_cameras.Count == 0)
            {
                <option value="">Nenhuma câmera encontrada</option>
            }
            @foreach (var cam in _cameras)
            {
                <option value="@cam.Id">@cam.Nome</option>
            }
        </select>
    </label>

    <video id="shelf-video" autoplay playsinline muted class="shelf-video"></video>
    <canvas id="shelf-canvas" class="shelf-canvas-hidden"></canvas>

    @if (!_isMonitoring)
    {
        <button class="btn-primary" @onclick="StartMonitoring" disabled="@(_selectedProductIds.Count == 0)">
            Iniciar monitoramento
        </button>
        @if (_selectedProductIds.Count == 0)
        {
            <p class="hint" style="text-align:center;">Selecione ao menos 1 produto acima primeiro.</p>
        }
    }
    else
    {
        <button class="btn-primary btn-suave" @onclick="StopMonitoring">Parar monitoramento</button>
        <div class="notification-bar" style="margin-top:0.75rem;"><span class="notification-pill pill-ok pill-viva"><span class="pill-dot"></span> Observando a prateleira...</span></div>
    }

    @if (!string.IsNullOrEmpty(_lastEventMessage))
    {
        <p class="hint" style="text-align:center;">Último evento: @_lastEventMessage</p>
    }
</div>

<div class="card">
    <h3 class="category-heading">Sessão aberta no momento</h3>
    @if (_currentSession is null)
    {
        <p class="hint">Nenhuma sessão aberta agora.</p>
    }
    else
    {
        @if (_currentSession.Items.Count == 0)
        {
            <p class="hint">Nenhum item ainda.</p>
        }
        else
        {
            @foreach (var item in _currentSession.Items)
            {
                <p>@item.Quantity x @item.ProductName — R$ @item.Subtotal.ToString("0.00")</p>
            }
        }
        <div class="card-total">
            <span class="card-total-etiqueta">Total desta sessão</span>
            <span class="total-value">R$ @_currentSession.Total.ToString("0.00")</span>
        </div>
    }
    <button class="btn-primary btn-outline" @onclick="RefreshAll">
        Atualizar
    </button>
</div>

@code {
    private List<ProductDto> _products = new();
    private HashSet<Guid> _selectedProductIds = new();
    private List<SessionDto> _pendingEntrySessions = new();
    private SessionDto? _currentSession;
    private bool _isMonitoring;
    private string? _lastEventMessage;
    private string? _errorMessage;
    private DotNetObjectReference<MonitorPrateleira>? _dotNetRef;

    private List<CameraOpcao> _cameras = new();
    private string? _cameraId;

    public sealed class CameraOpcao
    {
        public string Id { get; set; } = "";
        public string Nome { get; set; } = "";
    }

    // A lista so pode ser lida depois que a pagina existe no navegador.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await CarregarCameras();
        StateHasChanged();
    }

    private async Task CarregarCameras()
    {
        try
        {
            _cameras = await JS.InvokeAsync<List<CameraOpcao>>("shelfMonitor.listar") ?? new();
        }
        catch (JSException)
        {
            _cameras = new();
        }

        if (_cameras.Count == 0)
        {
            _cameraId = null;
            return;
        }

        // A camera desta prateleira e a VGA — e ela que fica apontada para os
        // produtos. Fica so como escolha INICIAL: o seletor manda, e camera
        // virtual (OBS, DroidCam) nunca deve ser escolhida sozinha.
        var preferida = _cameras.FirstOrDefault(
            c => c.Nome.Contains("VGA", StringComparison.OrdinalIgnoreCase));

        if (_cameraId is null || _cameras.All(c => c.Id != _cameraId))
        {
            _cameraId = (preferida ?? _cameras[0]).Id;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await RefreshAll();
    }

    private async Task RefreshAll()
    {
        _products = await ProductApi.GetAllAsync();
        _pendingEntrySessions = await SessionApi.GetPendingEntryAsync();
        _currentSession = await SessionApi.GetCurrentOpenAsync();
    }

    private void ToggleProduct(Guid productId, bool isChecked)
    {
        if (isChecked)
            _selectedProductIds.Add(productId);
        else
            _selectedProductIds.Remove(productId);
    }

    private async Task ConfirmEntry(string qrCodeToken)
    {
        var (success, error) = await SessionApi.ConfirmEntryAsync(qrCodeToken);

        if (!success)
        {
            _errorMessage = error ?? "Não foi possível confirmar a entrada.";
            return;
        }

        _errorMessage = null;
        await RefreshAll();
    }

    // `shelfMonitor.start` devolve null quando deu certo, ou a frase que
    // explica o que impediu. Nao lanca mais excecao: a pagina inteira caia
    // com "Ocorreu um erro inesperado" quando a webcam estava so ocupada.
    private async Task StartMonitoring()
    {
        _errorMessage = null;
        _dotNetRef = DotNetObjectReference.Create(this);

        string? falha;
        try
        {
            falha = await JS.InvokeAsync<string?>(
                "shelfMonitor.start", "shelf-video", "shelf-canvas", _dotNetRef, 2500, _cameraId);
        }
        catch (JSException ex)
        {
            falha = $"Falha ao falar com a câmera: {ex.Message}";
        }

        if (!string.IsNullOrEmpty(falha))
        {
            _errorMessage = falha;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
            _isMonitoring = false;
            return;
        }

        _isMonitoring = true;

        // Agora que a permissao foi dada, o navegador revela os nomes reais
        // das cameras. Antes disso a lista vem anonima, por privacidade.
        await CarregarCameras();
    }

    private async Task StopMonitoring()
    {
        try { await JS.InvokeVoidAsync("shelfMonitor.stop"); }
        catch (JSException) { /* parar uma camera que ja morreu nao e erro */ }
        _isMonitoring = false;
    }

    [JSInvokable]
    public async Task OnShelfChangeDetected(string beforeImageBase64, string afterImageBase64)
    {
        var result = await VisionApi.DetectShelfChangeAsync(_selectedProductIds.ToList(), beforeImageBase64, afterImageBase64);

        if (result is null)
        {
            _lastEventMessage = "Não consegui analisar a imagem agora.";
        }
        else
        {
            _lastEventMessage = result.Message;

            if (result.Action is "retirado" or "devolvido")
                _currentSession = await SessionApi.GetCurrentOpenAsync();
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isMonitoring)
        {
            try { await JS.InvokeVoidAsync("shelfMonitor.stop"); } catch { }
        }
        _dotNetRef?.Dispose();
    }
}
