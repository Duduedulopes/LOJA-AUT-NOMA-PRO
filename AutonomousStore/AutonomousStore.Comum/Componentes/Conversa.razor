@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IChamadoApiService Chamados
@inject HttpClient Http
@inject TokenDeQuemEsta Token

@*
    A CONVERSA DE UM CHAMADO — a mesma nos três aplicativos.

    Uma só, e não três: o cliente, o admin e o técnico veem exatamente o
    mesmo fio, com as bolhas do mesmo lado e a hora no mesmo formato. Se
    fossem três, a primeira correção iria para uma delas e as outras duas
    ficariam contando a história de um jeito ligeiramente diferente — que num
    registro de suporte é pior do que parece.

    O COMPONENTE FALA COM A API SOZINHO. As páginas só dizem qual chamado
    mostrar e quem está olhando; mandar a resposta, tratar a falha e
    redesenhar é problema daqui. Assim as três telas não repetem o mesmo
    try/catch.

    TODA COR TEM RESERVA (`var(--x, algo)`). Este componente entra em três
    CSS diferentes, e uma variável que não existe não dá erro nenhum: o
    navegador descarta a declaração e o texto herda o que estiver por perto.
    É o defeito mais caro de achar, porque nada quebra — só fica errado.
*@

<div class="conversa">

    @if (Chamado is null)
    {
        <p class="conversa-vazia">Nenhum chamado selecionado.</p>
    }
    else
    {
        <div class="conversa-fio">
            @foreach (var m in Chamado.Conversa)
            {
                <div class="fala @(EhMinha(m) ? "fala-minha" : "fala-dele")">
                    <div class="fala-quem">
                        <span class="fala-nome">@m.AutorNome</span>
                        <span class="fala-papel">@Papel(m.Autor)</span>
                        <span class="fala-hora">@Hora(m.QuandoUtc)</span>
                    </div>
                    <div class="fala-texto">@m.Texto</div>
                </div>
            }

            @if (Chamado.Conversa.Count == 0)
            {
                <p class="conversa-vazia">Ainda não há mensagens neste chamado.</p>
            }

            @* Dentro do fio, no fim, onde a proxima fala vai nascer — e nao
               numa barra no topo. Aviso longe do lugar do acontecimento vira
               ruido que o olho aprende a pular. *@
            @if (_quemDigita is { Length: > 0 })
            {
                <div class="conversa-digitando">
                    <span class="pontinhos"><i></i><i></i><i></i></span>
                    @_quemDigita está digitando…
                </div>
            }
        </div>

        @if (PodeResponder)
        {
            <div class="conversa-responder">
                @* SEM `@bind`, de proposito: o `@bind:event="oninput"` ocupa o
                   evento, e aqui a digitacao precisa fazer DUAS coisas — guardar
                   o texto e avisar o outro lado. `value` + `@oninput` deixa as
                   duas no mesmo lugar. *@
                <textarea value="@_texto"
                          @oninput="AoDigitar"
                          rows="3"
                          disabled="@_enviando"
                          placeholder="@Convite()"></textarea>

                <div class="conversa-acoes">
                    @if (_recado is { Length: > 0 })
                    {
                        <span class="conversa-recado @(_deuCerto ? "ok" : "ruim")">@_recado</span>
                    }
                    <button class="conversa-enviar"
                            disabled="@(_enviando || string.IsNullOrWhiteSpace(_texto))"
                            @onclick="Enviar">
                        @(_enviando ? "Enviando…" : "Enviar")
                    </button>
                </div>
            </div>
        }
    }
</div>

<style>
    .conversa { display: flex; flex-direction: column; gap: 14px; }

    .conversa-fio {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 46vh;
        overflow-y: auto;
        padding: 4px 2px;
    }

    .conversa-vazia {
        color: var(--ink-3, #6b7280);
        font-size: 14px;
        margin: 8px 2px;
    }

    .fala { max-width: 78%; }

    /* Quem está olhando fica à DIREITA, sempre. Alinhar por papel fixo faria
       a mesma conversa trocar de lado dependendo do app — e aí ninguém acha
       a própria fala de relance. */
    .fala-minha { align-self: flex-end; }
    .fala-dele  { align-self: flex-start; }

    .fala-quem {
        display: flex;
        gap: 8px;
        align-items: baseline;
        margin-bottom: 4px;
        font-size: 12px;
        color: var(--ink-3, #6b7280);
    }

    .fala-minha .fala-quem { justify-content: flex-end; }

    .fala-nome { font-weight: 700; color: var(--ink-2, #374151); }

    .fala-papel {
        padding: 1px 7px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        background: var(--tint-ciano, #e0f2fe);
        color: var(--texto-ciano, #075985);
    }

    .fala-texto {
        padding: 10px 14px;
        border-radius: 14px;
        border: 1px solid var(--line, #d4d4d8);
        background: var(--surface-solid, #ffffff);
        color: var(--ink, #18181b);
        font-size: 14.5px;
        line-height: 1.5;

        /* O texto vem cru do banco. `pre-wrap` preserva as quebras que a
           pessoa digitou sem interpretar nada como marcação. */
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .fala-minha .fala-texto {
        background: var(--tint-violeta, #ede9fe);
        border-color: var(--acao-violeta, #7c3aed);
        color: var(--texto-violeta, #4c1d95);
    }

    .conversa-digitando {
        align-self: flex-start;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 2px 4px;
        font-size: 13px;
        font-style: italic;
        color: var(--ink-3, #6b7280);
    }

    .pontinhos { display: inline-flex; gap: 3px; }

    .pontinhos i {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        animation: pulsa 1.2s infinite ease-in-out;
    }

    .pontinhos i:nth-child(2) { animation-delay: 0.2s; }
    .pontinhos i:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes pulsa {
        0%, 60%, 100% { opacity: 0.25; }
        30%           { opacity: 1; }
    }

    /* Respeita quem pediu menos movimento no sistema. O aviso continua
       legivel — so para de piscar. */
    @@media (prefers-reduced-motion: reduce) {
        .pontinhos i { animation: none; opacity: 0.6; }
    }

    .conversa-responder { display: flex; flex-direction: column; gap: 8px; }

    .conversa-responder textarea {
        width: 100%;
        padding: 11px 13px;
        border-radius: 12px;
        border: 1px solid var(--line, #d4d4d8);
        background: var(--surface-solid, #ffffff);
        color: var(--ink, #18181b);
        font: inherit;
        font-size: 14.5px;
        resize: vertical;
    }

    .conversa-acoes {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
    }

    .conversa-recado { font-size: 13px; font-weight: 600; }
    .conversa-recado.ok   { color: var(--texto-ciano, #075985); }
    .conversa-recado.ruim { color: #B3261E; }

    .conversa-enviar {
        padding: 9px 20px;
        border: 0;
        border-radius: 999px;
        background: var(--acao-violeta, #7c3aed);
        color: var(--sobre-acao, #ffffff);
        font: inherit;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
    }

    .conversa-enviar:disabled { opacity: 0.5; cursor: default; }
</style>

@code {
    /// <summary>O chamado que está sendo mostrado.</summary>
    [Parameter, EditorRequired]
    public ChamadoDto? Chamado { get; set; }

    /// <summary>Quem está olhando: "Cliente", "Admin" ou "Suporte".</summary>
    /// <remarks>
    /// Texto e não enum porque este componente vive em três aplicativos, e
    /// nenhum deles referencia o Domain só para dizer de que lado está.
    /// </remarks>
    [Parameter, EditorRequired]
    public string EuSou { get; set; } = "Cliente";

    [Parameter] public bool PodeResponder { get; set; } = true;

    /// <summary>Avisa a página com o chamado já atualizado depois de responder.</summary>
    [Parameter] public EventCallback<ChamadoDto> AoAtualizar { get; set; }

    private string _texto = "";
    private bool _enviando;
    private bool _deuCerto;
    private string _recado = "";

    // ── a conversa ao vivo ───────────────────────────────────────────────

    private HubConnection? _hub;

    /// <summary>Qual chamado esta conexao esta ouvindo agora. Nulo: nenhum.</summary>
    private Guid? _ouvindo;

    private bool _aoVivo;
    private string? _quemDigita;
    private CancellationTokenSource? _apagaDigitando;
    private DateTime _ultimoAviso = DateTime.MinValue;

    /// <remarks>
    /// A PAGINA TROCA O `Chamado` SEM RECRIAR O COMPONENTE. Quem clica em
    /// outro chamado da lista faz o Blazor reaproveitar esta mesma instancia,
    /// so com outro parametro — se a entrada no grupo acontecesse no
    /// `OnInitialized`, a tela mudaria e a conexao continuaria ouvindo o
    /// chamado anterior. As mensagens do chamado aberto nao chegariam, e as do
    /// antigo chegariam para ninguem.
    ///
    /// Comparar por `Id` e nao por referencia: o objeto e trocado a cada
    /// resposta, e reentrar no mesmo grupo a cada mensagem seria um ida e
    /// volta a toa no servidor.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        var alvo = Chamado?.Id;
        if (alvo == _ouvindo) return;

        await Desligar(_ouvindo);
        _ouvindo = alvo;

        if (alvo is { } id) await Ligar(id);
    }

    private async Task Ligar(Guid id)
    {
        try
        {
            if (_hub is null)
            {
                // O endereco da API vem do `HttpClient` que o app registrou.
                // Fixar a porta aqui quebraria o ClientApp, que descobre o
                // endereco sozinho para funcionar pelo IP da rede.
                var raiz = Http.BaseAddress
                    ?? throw new InvalidOperationException("HttpClient sem BaseAddress.");

                _hub = new HubConnectionBuilder()
                    .WithUrl(new Uri(raiz, "hubs/chamados"), opcoes =>
                    {
                        // Lido A CADA conexao, nunca guardado: quem sai e entra
                        // com outra conta nao pode seguir ouvindo a anterior.
                        opcoes.AccessTokenProvider = () => Task.FromResult(Token.Agora());
                    })
                    .WithAutomaticReconnect()
                    .Build();

                _hub.On<ChamadoDto>("MensagemNova", AoChegarMensagem);
                _hub.On<string, string>("Digitando", AoVerDigitando);

                // GRUPO NAO SOBREVIVE A RECONEXAO. O `WithAutomaticReconnect`
                // reabre o socket, mas o servidor esqueceu em que grupos esta
                // conexao estava — sem reentrar, a conversa fica "conectada" e
                // muda de novo. E o pior tipo de defeito: parece que funciona.
                _hub.Reconnected += async _ =>
                {
                    if (_ouvindo is { } atual)
                    {
                        try { await _hub!.InvokeAsync("Entrar", atual); } catch { }
                    }

                    _aoVivo = true;
                    await InvokeAsync(StateHasChanged);
                };

                _hub.Closed += async _ =>
                {
                    _aoVivo = false;
                    await InvokeAsync(StateHasChanged);
                };

                await _hub.StartAsync();
            }

            await _hub.InvokeAsync("Entrar", id);
            _aoVivo = true;
        }
        catch
        {
            // SEM EXCEÇÃO PARA CIMA. Tempo real e melhoria, nao requisito: se
            // o socket nao subir, a conversa continua funcionando do jeito
            // antigo — carrega ao abrir e envia por HTTP. Derrubar a tela de
            // pedir ajuda por causa do luxo seria trocar o essencial pelo
            // acessorio.
            _aoVivo = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task Desligar(Guid? id)
    {
        _quemDigita = null;

        if (_hub is null || id is not { } antigo) return;

        try { await _hub.InvokeAsync("Sair", antigo); } catch { }
    }

    /// <remarks>
    /// QUEM ESCREVEU TAMBEM RECEBE ISTO, e nao ha duplicata: o servidor manda
    /// o chamado INTEIRO, entao isto e substituicao e nao acrescimo. Mandar
    /// para o grupo todo deixa um caminho so para a mensagem aparecer, em vez
    /// de dois que podem discordar.
    /// </remarks>
    private async Task AoChegarMensagem(ChamadoDto atualizado)
    {
        // Chegou de um chamado que nao e o da tela: acontece na janela entre
        // trocar de chamado e o `Sair` chegar ao servidor.
        if (atualizado.Id != _ouvindo) return;

        Chamado = atualizado;

        // Quem falou obviamente parou de digitar. Sem isto, o aviso ficaria na
        // tela por mais tres segundos ao lado da mensagem que ele ja mandou.
        _quemDigita = null;

        await InvokeAsync(StateHasChanged);
        await AoAtualizar.InvokeAsync(atualizado);
    }

    /// <remarks>
    /// QUEM APAGA O AVISO E ESTE RELOGIO, e nao um "parei de digitar" vindo do
    /// outro lado. Se dependesse de uma segunda mensagem, fechar a aba no meio
    /// de uma frase deixaria "fulano esta digitando" na tela do outro para
    /// sempre.
    ///
    /// Nao espera os tres segundos aqui dentro: o tratador de evento do
    /// SignalR ficaria ocupado esse tempo todo, e o proximo aviso entraria na
    /// fila atras dele.
    /// </remarks>
    private Task AoVerDigitando(string quem, string papel)
    {
        _quemDigita = quem;
        _ = InvokeAsync(StateHasChanged);

        _apagaDigitando?.Cancel();
        _apagaDigitando?.Dispose();
        _apagaDigitando = new CancellationTokenSource();
        var ate = _apagaDigitando.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(3), ate);
                _quemDigita = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
                // Digitou de novo antes de apagar: o proximo relogio manda.
            }
        });

        return Task.CompletedTask;
    }

    /// <remarks>
    /// UM AVISO A CADA 1,5s, e nao um por tecla. Sem o freio, escrever uma
    /// frase dispararia trinta mensagens pelo socket para dizer a mesma coisa.
    /// Casa com os 3s de quem recebe: o aviso e renovado bem antes de expirar,
    /// entao o texto nao pisca durante a digitacao continua.
    /// </remarks>
    private async Task AoDigitar(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? "";

        if (_hub is null || !_aoVivo || _ouvindo is not { } id) return;
        if (string.IsNullOrWhiteSpace(_texto)) return;

        var agora = DateTime.UtcNow;
        if (agora - _ultimoAviso < TimeSpan.FromSeconds(1.5)) return;
        _ultimoAviso = agora;

        // `SendAsync` e nao `InvokeAsync`: nao ha resposta a esperar, e avisar
        // que esta digitando nao pode segurar a digitacao.
        try { await _hub.SendAsync("Digitando", id); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        _apagaDigitando?.Cancel();
        _apagaDigitando?.Dispose();

        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { }
        }
    }

    private bool EhMinha(MensagemDto m)
        => string.Equals(m.Autor, EuSou, StringComparison.OrdinalIgnoreCase);

    private static string Papel(string autor) => autor switch
    {
        "Suporte" => "suporte técnico",
        "Admin" => "administrador",
        "Cliente" => "cliente",
        _ => autor,
    };

    private static string Hora(DateTime utc)
        => utc.ToLocalTime().ToString("dd/MM HH:mm",
               System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

    private string Convite() => EuSou == "Suporte"
        ? "Responda a quem abriu o chamado…"
        : "Escreva aqui para o suporte técnico…";

    private async Task Enviar()
    {
        if (Chamado is null || string.IsNullOrWhiteSpace(_texto)) return;

        _enviando = true;
        _recado = "";

        var atualizado = await Chamados.ResponderAsync(Chamado.Id, _texto);

        _enviando = false;

        if (atualizado is null)
        {
            // Sem exceção: a tela de pedir ajuda não pode ser a que quebra.
            _deuCerto = false;
            _recado = "Não consegui enviar. Tenta de novo?";
            return;
        }

        _texto = "";
        _deuCerto = true;
        _recado = "Enviado.";
        Chamado = atualizado;
        await AoAtualizar.InvokeAsync(atualizado);
    }
}
