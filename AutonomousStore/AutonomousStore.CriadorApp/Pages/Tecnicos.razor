@page "/tecnicos"
@inject IPlatformApiService PlatformApi
@inject AppState AppState
@inject NavigationManager Nav

<h1>Técnicos</h1>
<p class="hint">A equipe de suporte. Ela é um serviço da plataforma: não pertence a nenhuma empresa e atende os chamados de todas.</p>

@if (!string.IsNullOrEmpty(_erro))
{
    <div class="error-message">@_erro</div>
}

@if (!string.IsNullOrEmpty(_sucesso))
{
    <div class="notification-bar"><span class="notification-pill pill-ok">
        <span class="pill-dot"></span> @_sucesso</span></div>
}

<div class="card">
    <h3 class="category-heading">Cadastrar novo técnico</h3>

    <EditForm Model="_novo" OnValidSubmit="CriarAsync">
        <div class="form-grid">
            <div class="form-group">
                <label>Nome</label>
                <InputText @bind-Value="_novo.Nome" />
            </div>
            <div class="form-group">
                <label>E-mail</label>
                <InputText @bind-Value="_novo.Email" type="email" />
            </div>
            <div class="form-group">
                <label>Telefone</label>
                <InputText @bind-Value="_novo.Telefone" placeholder="11999999999" />
            </div>
            <div class="form-group">
                <label>CPF</label>
                <InputText @bind-Value="_novo.Cpf" placeholder="somente números" />
            </div>
            <div class="form-group">
                <label>Senha</label>
                <InputText @bind-Value="_novo.Senha" type="password" />
                <span class="hint" style="margin:4px 0 0;">Mínimo 8 caracteres, com maiúscula, minúscula, número e caractere especial.</span>
            </div>
        </div>
        <button class="btn-primary btn-auto" type="submit" disabled="@_ocupado">
            @(_ocupado ? "Salvando..." : "Cadastrar técnico")
        </button>
    </EditForm>
</div>

<div class="card">
    <h3 class="category-heading">Equipe (@_tecnicos.Count)</h3>

    @if (_carregando)
    {
        <p class="hint">Carregando a equipe...</p>
    }
    else if (_tecnicos.Count == 0)
    {
        <p class="hint">Nenhum técnico cadastrado ainda. Use o formulário acima.</p>
    }
    else
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Situação</th>
                        <th>Cadastrado em</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tecnico in _tecnicos)
                    {
                        <tr>
                            <td>@tecnico.Nome</td>
                            <td>@tecnico.Email</td>
                            <td><span class="badge @(tecnico.Ativo ? "badge-ok" : "badge-out")">@(tecnico.Ativo ? "Ativo" : "Desativado")</span></td>
                            <td>@tecnico.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<TecnicoDto> _tecnicos = new();
    private NovoTecnicoModel _novo = new();
    private bool _carregando = true;
    private bool _ocupado;
    private string? _erro;
    private string? _sucesso;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        var (ok, dados, erro) = await PlatformApi.TecnicosAsync();

        if (ok)
            _tecnicos = (dados ?? new()).OrderBy(t => t.Nome).ToList();
        else
            _erro = erro ?? "Não foi possível carregar a equipe.";

        _carregando = false;
    }

    private async Task CriarAsync()
    {
        _erro = null;
        _sucesso = null;
        _ocupado = true;

        var (ok, erro) = await PlatformApi.CadastrarTecnicoAsync(new CadastrarTecnicoRequest(
            Name: _novo.Nome,
            Email: _novo.Email,
            PhoneNumber: _novo.Telefone,
            Cpf: _novo.Cpf,
            Password: _novo.Senha,
            ConfirmPassword: _novo.Senha));

        _ocupado = false;

        if (!ok)
        {
            _erro = erro ?? "Não foi possível cadastrar o técnico.";
            return;
        }

        _sucesso = $"Técnico \"{_novo.Nome}\" cadastrado.";
        _novo = new NovoTecnicoModel();
        await CarregarAsync();
    }

    private class NovoTecnicoModel
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefone { get; set; } = "";
        public string Cpf { get; set; } = "";
        public string Senha { get; set; } = "";
    }
}
