@inherits LayoutComponentBase
@implements IDisposable
@inject AppState AppState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <main>
        <div class="top-row px-4">
            <div class="top-row-left">
                @if (_showBackButton)
                {
                    <button class="back-button" @onclick="GoBack" title="Voltar">←</button>
                }
                <a class="marca" href="/">
                    <img src="img/logo-mark-alpha.png" alt="AutonomousStore" />
                    <span class="marca-texto">
                        <span class="marca-nome"><b>Autonomous</b><i>Store</i></span>
                    </span>
                </a>
            </div>

            @if (AppState.IsAuthenticated)
            {
                @* NavLink marca sozinho o item ativo pela rota. Nao ha estado
                   novo no componente: quem sabe a rota e o roteador. *@
                <nav class="menu-principal">
                    <NavLink class="menu-item" href="" Match="NavLinkMatch.All">Início</NavLink>
                    <NavLink class="menu-item" href="catalogo">Catálogo</NavLink>
                    <NavLink class="menu-item" href="minhas-compras">Compras</NavLink>
                    <NavLink class="menu-item" href="como-funciona">Ajuda</NavLink>
                    <NavLink class="menu-item" href="suporte">Suporte</NavLink>
                </nav>
            }

            @* No cliente o seletor fica FORA do `IsAuthenticated`: quem
               ainda nao entrou tambem ve a tela, e a tela de login era a
               mais clara de todas. *@
            <SeletorDeTema />

            @if (AppState.IsAuthenticated)
            {
                <div class="profile-menu">
                    <button class="profile-chip" @onclick="ToggleMenu">
                        <span class="profile-avatar">@GetInitial()</span>
                        <span class="profile-name">@AppState.CurrentCustomerName</span>
                        <span class="profile-caret">@(_isMenuOpen ? "▲" : "▼")</span>
                    </button>

                    @if (_isMenuOpen)
                    {
                        <div class="profile-dropdown">
                            <a class="profile-dropdown-item" @onclick='() => GoTo("/")'>🏠 Início</a>
                            <a class="profile-dropdown-item" @onclick='() => GoTo("/perfil")'>👤 Meu perfil</a>
                            <a class="profile-dropdown-item" @onclick='() => GoTo("/minhas-compras")'>🧾 Minhas compras</a>
                            <a class="profile-dropdown-item profile-dropdown-danger" @onclick="LogoutAndClose">🚪 Sair</a>
                        </div>
                    }
                </div>
            }
        </div>

        <article class="content px-4 @(_isHomePage ? "content-wide" : "")">
            @Body
        </article>
    </main>

    <footer class="rodape">
        <div class="rodape-marca">
            <img src="img/logo-mark-alpha.png" alt="" />
            <span class="rodape-linha">AutonomousStore</span>
        </div>
        @if (AppState.IsAuthenticated)
        {
            <a class="rodape-sair" @onclick="LogoutAndClose">Sair</a>
        }
    </footer>

    @*
        O GERENTE DA LOJA, ATENDENDO O COMPRADOR.

        Era o assistente do Gemini aqui. Saiu por dois motivos: dependia de
        uma API de fora que parou de responder duas vezes esta semana, e não
        sabia nada sobre ESTA loja — respondia sobre "uma loja autônoma" em
        geral, a partir de um texto de instruções fixo.

        O gerente sabe. É a mesma rede treinada nas 5.586 frases, os mesmos
        preços e o mesmo estoque que o painel do admin consulta.

        O QUE MUDA EM RELAÇÃO AO ADMIN está todo no perfil:
          · trata pelo primeiro nome de quem entrou, não por "Chefe"
          · só responde as doze intenções do mundo do comprador
          · não escreve nada — nenhuma das onze intenções de alteração

        O Gemini continua no sistema, na função em que ele é bom e que a
        rede não faz: ler a foto da prateleira (GeminiVisionService).
    *@
    @if (AppState.IsAuthenticated)
    {
        <GerenteChat Perfil="PerfilDeQuemFala.Cliente(AppState.CurrentCustomerName, AppState.CurrentCustomerId)" />
    }
</div>

@code {
    private bool _isMenuOpen;
    private bool _showBackButton;
    private bool _isHomePage;

    protected override void OnInitialized()
    {
        AppState.OnChange += HandleAppStateChanged;
        Nav.LocationChanged += HandleLocationChanged;
        UpdateRouteState(Nav.Uri);
    }

    private void HandleAppStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateRouteState(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateRouteState(string uri)
    {
        var path = Nav.ToBaseRelativePath(uri).Split('?')[0].TrimEnd('/');
        _showBackButton = path.Length > 0;
        _isHomePage = path.Length == 0;
    }

    private async Task GoBack()
    {
        _isMenuOpen = false;
        await JS.InvokeVoidAsync("history.back");
    }

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;

    private void GoTo(string url)
    {
        _isMenuOpen = false;
        Nav.NavigateTo(url);
    }

    private void LogoutAndClose()
    {
        _isMenuOpen = false;
        AppState.Logout();
        Nav.NavigateTo("/");
    }

    private string GetInitial()
    {
        var name = AppState.CurrentCustomerName;
        return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleAppStateChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
