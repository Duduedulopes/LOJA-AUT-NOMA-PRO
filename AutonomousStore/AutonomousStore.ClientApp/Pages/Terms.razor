@page "/termos-de-uso"

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 600px;">
        <h1 class="auth-title">Termos de Uso</h1>
        <p style="line-height:1.6; color:#444;">
            Este é um texto de exemplo para o protótipo da SmartGo Store. Antes de lançar o app de
            verdade, substitua este conteúdo pelos termos de uso reais, revisados por um profissional
            jurídico — cobrindo coleta de dados pessoais (nome, e-mail, CPF, telefone), uso da forma de
            pagamento cadastrada, funcionamento do acesso à loja via QR code, e política de privacidade
            (LGPD).
        </p>
        <a href="/cadastro" class="btn-primary" style="display:inline-block; text-align:center; text-decoration:none; margin-top:1rem;">
            Voltar para o cadastro
        </a>
    </div>
</div>
