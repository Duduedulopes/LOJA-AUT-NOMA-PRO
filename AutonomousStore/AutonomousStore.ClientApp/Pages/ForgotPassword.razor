@page "/esqueci-senha"
@inject IAuthApiService AuthApi
@inject NavigationManager Nav

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-icon"><svg width="46" height="58" viewBox="0 -12 24 34" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--cyan); filter: drop-shadow(0 0 12px rgba(34, 211, 238, 0.6));"><path d="M5 -6a10 10 0 0 1 14 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><path d="M8 -3a6 6 0 0 1 8 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="12" cy="-1" r="1" fill="currentColor" /><circle cx="9" cy="21" r="1.1" fill="currentColor" /><circle cx="20" cy="21" r="1.1" fill="currentColor" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg></div>
        <h1 class="auth-title">Esqueceu sua senha?</h1>

        @if (_sent)
        {
            <p class="auth-subtitle">
                Se <strong>@_email</strong> estiver cadastrado, enviamos um e-mail com um link pra você
                escolher uma nova senha. O link vale por 30 minutos.
            </p>
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Voltar pro login</button>
        }
        else
        {
            <p class="auth-subtitle">Informe seu e-mail. Vamos te mandar um link pra redefinir a senha.</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-message">@_errorMessage</div>
            }

            <EditForm Model="this" OnValidSubmit="SendAsync">
                <div class="form-group">
                    <label>E-mail</label>
                    <InputText @bind-Value="_email" type="email" />
                </div>
                <button class="btn-primary" type="submit" disabled="@_isSending">
                    @(_isSending ? "Enviando..." : "Enviar link de redefinição")
                </button>
            </EditForm>

            <p class="auth-footer-link">
                <a href="/login">Voltar pro login</a>
            </p>
        }
    </div>
</div>

@code {
    private string _email = "";
    private bool _isSending;
    private bool _sent;
    private string? _errorMessage;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Informe um e-mail.";
            return;
        }

        _isSending = true;
        _errorMessage = null;

        var (success, error) = await AuthApi.ForgotPasswordAsync(_email);

        _isSending = false;

        if (!success)
        {
            _errorMessage = error ?? "Não foi possível enviar o e-mail agora. Tente de novo em instantes.";
            return;
        }

        _sent = true;
    }
}
