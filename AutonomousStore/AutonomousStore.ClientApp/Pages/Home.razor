@page "/"
@inject AppState AppState
@inject ISessionApiService SessionApi
@inject NavigationManager Nav

@if (!AppState.IsAuthenticated)
{
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-icon"><svg width="46" height="58" viewBox="0 -12 24 34" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 -6a10 10 0 0 1 14 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><path d="M8 -3a6 6 0 0 1 8 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="12" cy="-1" r="1" fill="currentColor" /><circle cx="9" cy="21" r="1.1" fill="currentColor" /><circle cx="20" cy="21" r="1.1" fill="currentColor" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg></div>
            <h1 class="auth-title">Bem-vindo(a)</h1>
            <p class="auth-subtitle">Entre ou cadastre-se para começar a comprar na loja autônoma.</p>
            <button class="btn-primary" @onclick="GoToLogin">Entrar</button>
            <p class="auth-footer-link">
                Ainda não tem cadastro? <a href="/cadastro">Criar cadastro</a>
            </p>
            <p class="auth-footer-link">
                <a href="/como-funciona">Como funciona a loja?</a>
            </p>
            <p class="auth-footer-link">
                <a href="/catalogo">Ver catálogo de produtos</a>
            </p>
        </div>
    </div>
}
else
{
    <div class="dashboard">
        <section class="hero">
            <img class="hero-marca" src="img/logo-mark-alpha.png" alt="" aria-hidden="true" />
            <span class="hero-pill">Loja aberta agora</span>
            <h1 class="hero-titulo">Olá, @AppState.CurrentCustomerName, sua jornada de compras está prestes a começar.</h1>
            <p class="hero-apoio">Gere o código, e aproxime do leitor. Lembre-se de configurar a forma de pagamento.</p>
            <div class="hero-acoes">
                <button class="btn-branco" @onclick="GoToOpenStore">Gerar QR code de entrada</button>
                <button class="btn-outline" @onclick="GoToHowItWorks">Como funciona</button>
            </div>
        </section>

        @if (_isLoadingStatus)
        {
            <p class="hint">Verificando sua sessão...</p>
        }
        else if (_activeSession is not null && _activeSession.Status == SessionStatus.AguardandoEntrada)
        {
            <div class="status-banner status-active">
                <span class="status-text"><span class="live-dot"></span>Seu QR code está esperando a entrada na loja.</span>
                <button class="btn-primary btn-small" style="width:auto;" @onclick='() => Nav.NavigateTo("/abrir-loja")'>Continuar</button>
            </div>
        }
        else if (_activeSession is not null && _activeSession.Status == SessionStatus.Aberta)
        {
            <div class="status-banner status-active">
                <span class="status-text"><span class="live-dot"></span>Você está na loja agora — R$ @_activeSession.Total.ToString("0.00") no carrinho.</span>
                <button class="btn-primary btn-small" style="width:auto;" @onclick='() => Nav.NavigateTo("/carrinho")'>Ver carrinho</button>
            </div>
        }
        else if (_activeSession is not null && _activeSession.Status == SessionStatus.AguardandoPagamento)
        {
            <div class="status-banner status-active">
                <span class="status-text"><span class="live-dot"></span>Compra fechada — falta confirmar o pagamento.</span>
                <button class="btn-primary btn-small" style="width:auto;" @onclick='() => Nav.NavigateTo("/checkout")'>Pagar agora</button>
            </div>
        }
        else
        {
            <div class="faixa-qr">
                <div class="faixa-qr-codigo">
                    <span class="faixa-qr-marca-dagua">QR CODE</span>
                </div>
                <div class="faixa-qr-texto">
                    <span class="faixa-qr-etiqueta">Seu código de entrada</span>
                    <h2 class="faixa-qr-titulo">Gere o código para entrar</h2>
                    <p class="faixa-qr-apoio">
                        Aproxime a tela do leitor na entrada. O código vale por poucos minutos;
                        se expirar, gere outro pelo botão ao lado.
                    </p>
                </div>
                <div class="faixa-qr-acoes">
                    <button class="btn-primary" @onclick="GoToOpenStore">Gerar novo código</button>
                    <button class="btn-outline" @onclick="GoToCatalog">Ver catálogo</button>
                </div>
            </div>
        }

        <div class="grade-resumo">
            <button type="button" class="card-resumo tom-rosa" @onclick="GoToLiveCart">
                <span class="card-resumo-etiqueta">Carrinho</span>
                <span class="card-resumo-valor">
                    R$ @((_activeSession is not null && _activeSession.Status == SessionStatus.Aberta) ? _activeSession.Total.ToString("0.00") : "0,00")
                </span>
                <span class="card-resumo-apoio">Ver carrinho →</span>
            </button>

            <button type="button" class="card-resumo tom-ciano" @onclick="GoToCatalog">
                <span class="card-resumo-etiqueta">Catálogo</span>
                <span class="card-resumo-valor">Produtos</span>
                <span class="card-resumo-apoio">O que está na prateleira</span>
            </button>

            <button type="button" class="card-resumo tom-violeta" @onclick="GoToPurchases">
                <span class="card-resumo-etiqueta">Minhas compras</span>
                <span class="card-resumo-valor">Histórico</span>
                <span class="card-resumo-apoio">Recibos e valores</span>
            </button>

            <button type="button" class="card-resumo tom-branco" @onclick="GoToProfile">
                <span class="card-resumo-etiqueta">Perfil</span>
                <span class="card-resumo-valor">Pagamento</span>
                <span class="card-resumo-apoio">Forma de pagamento</span>
            </button>
        </div>
    </div>
}

@code {
    private SessionDto? _activeSession;
    private bool _isLoadingStatus = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated || AppState.CurrentCustomerId is null)
        {
            _isLoadingStatus = false;
            return;
        }

        _activeSession = await SessionApi.GetActiveAsync(AppState.CurrentCustomerId.Value);
        _isLoadingStatus = false;
    }

    private void GoToLogin() => Nav.NavigateTo("/login");
    private void GoToOpenStore() => Nav.NavigateTo("/abrir-loja");
    private void GoToLiveCart() => Nav.NavigateTo("/carrinho");
    private void GoToCatalog() => Nav.NavigateTo("/catalogo");
    private void GoToPurchases() => Nav.NavigateTo("/minhas-compras");
    private void GoToProfile() => Nav.NavigateTo("/perfil");
    private void GoToHowItWorks() => Nav.NavigateTo("/como-funciona");

    private void Logout()
    {
        AppState.Logout();
        Nav.NavigateTo("/");
    }

    private string GetInitial()
    {
        var name = AppState.CurrentCustomerName;
        return string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
    }
}
