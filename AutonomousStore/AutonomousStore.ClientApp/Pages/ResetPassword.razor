@page "/redefinir-senha"
@inject IAuthApiService AuthApi
@inject NavigationManager Nav

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-icon"><svg width="46" height="58" viewBox="0 -12 24 34" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--cyan); filter: drop-shadow(0 0 12px rgba(34, 211, 238, 0.6));"><path d="M5 -6a10 10 0 0 1 14 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><path d="M8 -3a6 6 0 0 1 8 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="12" cy="-1" r="1" fill="currentColor" /><circle cx="9" cy="21" r="1.1" fill="currentColor" /><circle cx="20" cy="21" r="1.1" fill="currentColor" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg></div>
        <h1 class="auth-title">Escolher nova senha</h1>

        @if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_token))
        {
            <p class="auth-subtitle">Esse link de redefinição parece incompleto ou inválido.</p>
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/esqueci-senha")'>Pedir um novo link</button>
        }
        else if (_success)
        {
            <p class="auth-subtitle">Senha atualizada com sucesso! Já pode entrar com a nova senha.</p>
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Ir para o login</button>
        }
        else
        {
            <p class="auth-subtitle">Definindo uma nova senha para <strong>@_email</strong>.</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-message">@_errorMessage</div>
            }

            <EditForm Model="this" OnValidSubmit="SubmitAsync">
                <div class="form-group">
                    <label>Nova senha</label>
                    <div class="password-field">
                        <InputText @bind-Value="_newPassword" type="@(_showPassword ? "text" : "password")" />
                        <button type="button" class="toggle-password" @onclick="() => _showPassword = !_showPassword">
                            @(_showPassword ? "🙈" : "👁")
                        </button>
                    </div>
                    <p class="password-hint">Mínimo 8 caracteres, com maiúscula, minúscula, número e caractere especial.</p>
                </div>
                <div class="form-group">
                    <label>Confirmar nova senha</label>
                    <InputText @bind-Value="_confirmPassword" type="@(_showPassword ? "text" : "password")" />
                </div>
                <button class="btn-primary" type="submit" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Salvando..." : "Redefinir senha")
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    private string? _email;
    private string? _token;
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showPassword;
    private bool _isSubmitting;
    private bool _success;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        var query = ParseQuery(Nav.Uri);
        query.TryGetValue("email", out _email);
        query.TryGetValue("token", out _token);
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_token))
            return;

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "As senhas não coincidem.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var (success, error) = await AuthApi.ResetPasswordAsync(_email, _token, _newPassword);

        _isSubmitting = false;

        if (!success)
        {
            _errorMessage = error ?? "Não foi possível redefinir a senha.";
            return;
        }

        _success = true;
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>();
        var idx = uri.IndexOf('?');

        if (idx < 0)
            return result;

        var query = uri[(idx + 1)..];

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(parts[0]);
            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
            result[key] = value;
        }

        return result;
    }
}
