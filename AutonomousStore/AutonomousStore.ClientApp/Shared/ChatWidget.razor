@inject IChatApiService ChatApi

<button class="chat-toggle-button" @onclick="ToggleOpen" title="Falar com o assistente">
    @(_isOpen ? "✕" : "💬")
</button>

@if (_isOpen)
{
    <div class="chat-panel">
        <div class="chat-panel-header">
            <span>Assistente AutonomousStore</span>
        </div>

        <div class="chat-messages" @ref="_messagesRef">
            @foreach (var fala in _falas)
            {
                <div class="chat-message @(fala.Role == "user" ? "chat-message-user" : "chat-message-bot")">
                    @fala.Texto
                </div>
            }
            @if (_isSending)
            {
                <div class="chat-message chat-message-bot chat-message-typing">Digitando...</div>
            }
        </div>

        <div class="chat-input-row">
            <input @bind="_input" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Digite sua dúvida..." disabled="@_isSending" />
            <button @onclick="SendMessage" disabled="@(_isSending || string.IsNullOrWhiteSpace(_input))">➤</button>
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private bool _isSending;
    private string _input = "";
    private ElementReference _messagesRef;
    /// <summary>Uma linha do chat — e se ela conta ou não como conversa.</summary>
    /// <remarks>
    /// O QUE APARECE NA TELA E O QUE O MODELO VÊ NÃO SÃO A MESMA COISA.
    ///
    /// A saudação e as mensagens de erro são recado da INTERFACE: ninguém
    /// falou aquilo. Mandá-las como histórico foi o que quebrou o assistente
    /// — o Gemini exige que a conversa comece com uma fala do usuário, e a
    /// primeira coisa que ia daqui era a saudação, marcada como `model`.
    ///
    /// Pior: a própria mensagem de erro entrava como histórico. Cada tentativa
    /// mandava uma conversa mais suja que a anterior, e o assistente ficava
    /// mais longe de funcionar a cada vez que se insistia.
    ///
    /// Uma lista só, com um sinalizador. Duas listas em paralelo sairiam de
    /// sincronia no primeiro caso de borda.
    /// </remarks>
    private record Fala(string Role, string Texto, bool SoNaTela = false);

    private readonly List<Fala> _falas = new()
    {
        new Fala("model",
            "Olá! Sou o assistente da AutonomousStore 🤖 Posso ajudar com dúvidas sobre como a loja funciona, cadastro e pagamento. Como posso ajudar?",
            SoNaTela: true),
    };

    private void ToggleOpen() => _isOpen = !_isOpen;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_input) && !_isSending)
            await SendMessage();
    }

    private async Task SendMessage()
    {
        var text = _input.Trim();
        if (string.IsNullOrWhiteSpace(text))
            return;

        _falas.Add(new Fala("user", text));
        _input = "";
        _isSending = true;
        StateHasChanged();

        // Só o que é conversa de verdade sobe. Saudação e recado de erro
        // ficam na tela e não viram histórico.
        var paraOModelo = _falas
            .Where(f => !f.SoNaTela)
            .Select(f => new ChatMessageDto(f.Role, f.Texto))
            .ToList();

        var reply = await ChatApi.SendAsync(paraOModelo);

        // `deuCerto` decide se a resposta entra no histórico. Um "não consegui
        // falar com o agente" guardado como fala do modelo envenena a próxima
        // pergunta — e a pessoa que insiste piora a situação sem saber.
        var deuCerto = !reply.StartsWith("Não consegui", StringComparison.OrdinalIgnoreCase)
                    && !reply.StartsWith("O agente ainda não foi configurado", StringComparison.OrdinalIgnoreCase);

        _falas.Add(new Fala("model", reply, SoNaTela: !deuCerto));
        _isSending = false;
        StateHasChanged();
    }
}
