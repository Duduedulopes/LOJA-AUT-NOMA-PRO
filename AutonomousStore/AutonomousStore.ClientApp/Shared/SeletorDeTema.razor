@inject IJSRuntime JS

@* ═══════════════════════════════════════════════════════════════════════
   Dois modos: claro e escuro.

   POR QUE NÃO HÁ UM BOTÃO DE "PADRÃO DO SISTEMA"

   Havia. O Eduardo apontou que ele e o escuro "são a mesma coisa" — e
   estavam, porque o computador dele está no escuro. Um botão que parece
   idêntico ao vizinho não informa nada; ele só faz a pessoa clicar para
   descobrir que não mudou.

   O comportamento não se perdeu, mudou de lugar: enquanto ninguém
   escolheu nada, o app SEGUE o sistema — e segue ao vivo, se o
   computador virar escuro às 18h o app vira junto. No primeiro clique a
   escolha passa a valer e o sistema deixa de mandar.

   Isso é melhor que o botão: o padrão certo acontece sem ninguém pedir, e
   quem quiser fixar, fixa. O que se perde é poder VOLTAR a seguir o
   sistema depois de ter escolhido — e isso quase ninguém faz.

   POR QUE O ESTILO MORA AQUI DENTRO

   A primeira versão punha o CSS no `tema.css`. Aí o arquivo não chegou ao
   servidor — era novo, e arquivo novo em `wwwroot/` só entra no manifesto
   quando o `dotnet run` sobe — e o resultado foram três quadrados vazios
   na barra. O componente estava certo; faltava o companheiro dele.

   Um controle que depende de um segundo arquivo chegar junto tem duas
   chances de estar quebrado. Com o estilo aqui, se o componente aparece,
   ele aparece certo. É o mesmo caminho que o `GerenteChat` já segue.

   O `tema.css` continua existindo, mas só com a PALETA escura — que é
   coisa do app inteiro, não deste botão.

   ISTO AQUI NÃO PINTA NADA

   Quem pinta é o script no `<head>` do `index.html`, que já rodou antes do
   Blazor existir (senão a tela pisca branca enquanto o WebAssembly
   carrega). O papel deste componente é mostrar qual está ativo e avisar
   quando o Chefe clicar.

   Por isso `_escolha` começa nula e só é lida no `OnAfterRenderAsync`:
   chamar `IJSRuntime` na primeira renderização estoura no WebAssembly.
   Enquanto não sabe, não marca nada — que é honesto.
   ═══════════════════════════════════════════════════════════════════════ *@

<div class="tema-seletor" role="group" aria-label="Tema da tela" data-em="@(_escolha ?? "")">
    <span class="tema-marca" aria-hidden="true"></span>

    <button type="button" class="tema-op" title="Claro" aria-label="Tema claro"
            aria-pressed='@Marcado("claro")' @onclick='() => Trocar("claro")'>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4" />
        </svg>
    </button>

    <button type="button" class="tema-op" title="Escuro" aria-label="Tema escuro"
            aria-pressed='@Marcado("escuro")' @onclick='() => Trocar("escuro")'>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 13.5A8.5 8.5 0 1 1 10.5 4a6.8 6.8 0 0 0 9.5 9.5Z" />
        </svg>
    </button>

</div>

<style>
    .tema-seletor {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0;
        padding: 3px;
        border: 1px solid var(--line, #e6e3ee);
        border-radius: 999px;
        background: var(--vidro, rgba(255, 255, 255, .6));
        /* Sem isto o seletor cresce junto com a barra e vira uma faixa. */
        flex: none;
    }

    /* A MARCA QUE DESLIZA.
       Um fundo por baixo dos três, que anda até o escolhido. É ela que faz
       o controle parecer um interruptor de três posições em vez de três
       botões soltos — e a animação conta de onde para onde foi, que um
       simples "acende o novo, apaga o velho" não conta. */
    .tema-marca {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: var(--tint-violeta, #ede5ff);
        box-shadow: inset 0 0 0 1px var(--acao-violeta, #7b4fd8);
        opacity: 0;
        transform: translateX(0);
        transition: transform .26s cubic-bezier(.34, 1.3, .64, 1), opacity .18s;
        pointer-events: none;
    }

    /* Enquanto o componente não sabe qual é o tema (antes do JS responder),
       a marca fica invisível — melhor nada do que marcar o errado por um
       instante. */
    .tema-seletor[data-em="claro"]  .tema-marca { opacity: 1; transform: translateX(0); }
    .tema-seletor[data-em="escuro"] .tema-marca { opacity: 1; transform: translateX(32px); }

    .tema-op {
        position: relative;
        z-index: 1;
        display: inline-grid;
        place-items: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--ink-3, #6b6673);
        cursor: pointer;
        transition: color .16s, transform .16s;
        -webkit-tap-highlight-color: transparent;
    }

    .tema-op:hover  { color: var(--ink, #14121c); }
    .tema-op:active { transform: scale(.9); }
    .tema-op[aria-pressed="true"] { color: var(--texto-violeta, #4a2f86); }

    /* O anel de foco só para quem chega pelo teclado. No clique ele parece
       mais uma cor entrando no controle do que um indicador. */
    .tema-op:focus { outline: none; }
    .tema-op:focus-visible {
        outline: 2px solid var(--acao-violeta, #7b4fd8);
        outline-offset: 2px;
    }

    .tema-op svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* O sol ganha um giro de leve ao ser escolhido; a lua, uma inclinada.
       Movimento curto, uma vez só — o que dá vida sem virar enfeite. */
    .tema-op[aria-pressed="true"] svg { animation: tema-entra .32s ease-out; }
    @@keyframes tema-entra {
        from { transform: rotate(-35deg) scale(.82); opacity: .5; }
        to   { transform: none; opacity: 1; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .tema-marca { transition: opacity .18s; }
        .tema-op, .tema-op[aria-pressed="true"] svg { transition: none; animation: none; }
    }
</style>

@code {
    private string? _escolha;

    private string Marcado(string qual) => _escolha == qual ? "true" : "false";

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (!primeira) return;
        try
        {
            // `emVigor`, e não a escolha guardada: sem ninguém ter
            // escolhido, o guardado é "nada" e o botão não marcaria
            // nenhum dos dois — mas a tela JÁ está clara ou escura, e é
            // isso que o controle tem de refletir.
            _escolha = await JS.InvokeAsync<string>("tema.emVigor");
            StateHasChanged();
        }
        catch (JSException)
        {
            // O script do tema não carregou. O app inteiro continua
            // funcionando no claro; só este seletor fica sem marcar nada.
            // Derrubar a tela por causa de um botão de cor seria
            // desproporcional.
        }
    }

    private async Task Trocar(string qual)
    {
        _escolha = qual;
        try { await JS.InvokeVoidAsync("tema.aplicar", qual); }
        catch (JSException) { }
    }
}
