<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AutonomousStore.Domain\AutonomousStore.Domain.csproj" />
	</ItemGroup>

	<!-- A conversa de suporte: DTOs, serviço e o componente das bolhas.
	     Magra de propósito — o app do cliente também depende dela. -->
	<ItemGroup>
		<ProjectReference Include="..\AutonomousStore.Comum\AutonomousStore.Comum.csproj" />
	</ItemGroup>

	<!--
	  O MESMO gerente do painel, atendendo o comprador.

	  Vem junto o modelo treinado de 654 KB, e isso foi pesado e aceito: a
	  loja tem wifi, e a alternativa (classificar no servidor) seria uma ida
	  e volta a cada pergunta mais uma segunda cópia do classificador.

	  Quem limita o que ele diz ao cliente NÃO é o que está aqui — é o
	  PerfilDeQuemFala.Cliente, com lista de permissão.
	-->
	<ItemGroup>
		<ProjectReference Include="..\AutonomousStore.Gerente\AutonomousStore.Gerente.csproj" />
	</ItemGroup>


</Project>
