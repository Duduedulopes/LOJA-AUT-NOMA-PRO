<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutonomousStore.Gerente\AutonomousStore.Gerente.csproj" />
  </ItemGroup>

  <!-- O modelo que o Rede-Neural (Python) treinou e que os apps baixam. É ele, e não uma lista
       copiada aqui, que diz quais intenções existem: uma intenção nova treinada amanhã aparece
       nos testes sozinha — e nasce RECUSADA para o técnico, o Criador e o comprador. -->
  <ItemGroup>
    <Content Include="..\AutonomousStore.Gerente\wwwroot\modelos\intencao.json" Link="modelos\intencao.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
