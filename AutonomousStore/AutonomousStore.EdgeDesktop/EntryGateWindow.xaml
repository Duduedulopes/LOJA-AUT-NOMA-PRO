<Window x:Class="AutonomousStore.EdgeDesktop.EntryGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leitora de Entrada"
        WindowStyle="SingleBorderWindow"
        WindowState="Normal"
        Width="900"
        Height="600"
        ResizeMode="CanResize"
        Topmost="False"
        Background="Black"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Image x:Name="VideoImage" Stretch="UniformToFill" MinWidth="1" MinHeight="1" />

        <!-- Instrução discreta -->
        <Border Background="#66000000"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Padding="16"
                CornerRadius="8">
            <TextBlock Text="Aponte o QR code do cliente"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold" />
        </Border>

        <!-- Overlay (verde/vermelho) -->
        <Grid x:Name="Overlay"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="80">
                <TextBlock x:Name="OverlayTitle"
                           Foreground="White"
                           FontSize="48"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayMessage"
                           Foreground="White"
                           FontSize="24"
                           Margin="0,16,0,0"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="700" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

