<Window x:Class="AutonomousStore.EdgeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Loja Autônoma"
        Height="720"
        Width="960"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Caixa - Loja Autônoma"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="Atualizar produtos"
                    Margin="16,0,0,0"
                    Padding="12,6"
                    Command="{Binding LoadProductsCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Produtos" Padding="8">
                <DataGrid ItemsSource="{Binding Products}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="120"/>
                        <DataGridTextColumn Header="Preço" Binding="{Binding Price, StringFormat=C2}" Width="90"/>
                        <DataGridTemplateColumn Header="Ação" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Adicionar"
                                            Padding="8,4"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Carrinho (manual)" Padding="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{Binding CartItemCount, StringFormat='Itens: {0}'}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat='Total: {0:C2}'}" FontSize="18" FontWeight="Bold" Margin="0,4,0,8"/>
                        <Button Content="Limpar carrinho"
                                Padding="10,6"
                                Command="{Binding ClearCartCommand}"/>
                    </StackPanel>

                    <ListView ItemsSource="{Binding CartItems}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Produto" DisplayMemberBinding="{Binding Name}" Width="140"/>
                                <GridViewColumn Header="Qtd" DisplayMemberBinding="{Binding Quantity}" Width="40"/>
                                <GridViewColumn Header="Subtotal" DisplayMemberBinding="{Binding Subtotal, StringFormat=C2}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="RFID (simulado) — Sessão do cliente" Padding="8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Id da sessão:" VerticalAlignment="Center" Width="110"/>
                        <TextBox Text="{Binding SessionIdInput, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                        <Button Content="Carregar sessão" Margin="8,0,0,0" Padding="10,4" Command="{Binding LoadSessionCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Tag lida:" VerticalAlignment="Center" Width="110"/>
                        <TextBox Text="{Binding RfidTagInput, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                        <Button Content="Simular leitura" Margin="8,0,0,0" Padding="10,4" Command="{Binding SimulateRfidReadCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding CurrentSession.Status, StringFormat='Status da sessão: {0}'}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentSession.Total, StringFormat='Total da sessão: {0:C2}'}" FontWeight="Bold"/>
                </StackPanel>

                <ListView Grid.Column="2" ItemsSource="{Binding SessionItems}" Height="110">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Produto" DisplayMemberBinding="{Binding ProductName}" Width="150"/>
                            <GridViewColumn Header="Qtd" DisplayMemberBinding="{Binding Quantity}" Width="40"/>
                            <GridViewColumn Header="Subtotal" DisplayMemberBinding="{Binding Subtotal, StringFormat=C2}" Width="80"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="{Binding StatusMessage}"
                   Foreground="Gray"/>
    </Grid>
</Window>
