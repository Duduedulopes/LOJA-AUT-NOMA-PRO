<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AutonomousStore.Domain\AutonomousStore.Domain.csproj" />
	</ItemGroup>

	<!--
	  O MESMO gerente do painel do admin, e nao uma cópia dele.

	  Vem junto: o chat, o classificador, os serviços que ele lê e o modelo
	  treinado de 654 KB, que o SDK do Razor serve daqui em
	  `_content/AutonomousStore.Gerente/modelos/`.
	-->
	<ItemGroup>
		<ProjectReference Include="..\AutonomousStore.Gerente\AutonomousStore.Gerente.csproj" />
	</ItemGroup>

	<!-- A conversa de suporte: DTOs, serviço e o componente das bolhas.
	     Magra de propósito — o app do cliente também depende dela. -->
	<ItemGroup>
		<ProjectReference Include="..\AutonomousStore.Comum\AutonomousStore.Comum.csproj" />
	</ItemGroup>


</Project>
